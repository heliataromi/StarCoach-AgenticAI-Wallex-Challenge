# ==============================================================================
# StarCoach Wallex Hackathon Challenge - Environment Configuration
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Wallex Exchange Credentials
# ------------------------------------------------------------------------------
# Wallex API Key from your profile settings (for live trading and account balance)
WALLEX_API_KEY=""

# Dedicated 5M TMN Credit Sub-Account ID provided for the hackathon
WALLEX_SUB_ACCOUNT_ID="hackathon-sub-5m"

# Wallex API Base URL (Default: https://api.wallex.ir)
WALLEX_BASE_URL="https://api.wallex.ir"


# ------------------------------------------------------------------------------
# 2. Free Development & Testing LLM: Google AI Studio (Gemini)
# Get a 100% free API key from: https://aistudio.google.com/
# Recommended models from https://ai.google.dev/gemini-api/docs/models:
#   - gemini-3.8-flash (Recommended: Latest Stable Flash, September 2026, 1M context, low latency)
#   - gemini-3.1-flash-lite / gemini-3.5-flash-lite (Ultra-fast throughput)
#   - gemini-4-argon (Frontier reasoning flagship, October 2026)
# Use this during development & testing to preserve your BoxAPI credit!
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"


# ------------------------------------------------------------------------------
# 3. Production Competition LLM: BoxAPI (StarCoach Official Partner)
# Base URL: https://ai.boxapi.ir/ai/v1
# $3.00 credit provided for the hackathon competition.
# ------------------------------------------------------------------------------
BOXAPI_API_KEY=""
BOXAPI_BASE_URL="https://ai.boxapi.ir/ai/v1"

# Flagship model for high-conviction Bull vs. Bear arbitration
BOXAPI_MODEL="gpt-6-astra"

# Low-cost model for routine 15m macro surveillance & post-trade reflection
BOXAPI_MINI_MODEL="gpt-5.4-mini"

# Safety budget cap in USD to prevent exhausting the $3.00 credit (Default: $2.50)
BOXAPI_BUDGET_USD="2.50"


# ------------------------------------------------------------------------------
# 4. Engine Operating Defaults & Execution Mode
# ------------------------------------------------------------------------------
# Operating mode: "shadow" (live paper-trading on orderbook) | "live" (real spot orders) | "backtest"
TRADING_MODE="shadow"

# Active LLM Provider: "offline" | "gemini" | "boxapi"
# Recommended: "gemini" for free testing, "boxapi" for production challenge
LLM_PROVIDER="offline"

# Default trading pairs (separated by comma)
TRADING_SYMBOLS="BTCTMN,ETHTMN,USDTTMN"

# Dedicated initial credit capital in Iranian Toman (TMN)
INITIAL_EQUITY_TMN="5000000"

# Directory for immutable SHA-256 signed decision audit logs
DECISION_LOG_DIR="decision_logs"


# ------------------------------------------------------------------------------
# 5. Cloud Deployment & Liquidation Deadline (Liara PaaS / Docker)
# ------------------------------------------------------------------------------
# Web dashboard & health check port (automatically set by Liara PaaS)
PORT="8080"

# Pre-deadline mandatory liquidation timestamp (ISO-8601 string or epoch seconds)
# Automatically liquidates 100% of crypto coin balances back to Iranian Toman before this cutoff
CHALLENGE_DEADLINE="2026-10-26T18:00:00+03:30"

